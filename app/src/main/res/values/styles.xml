<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ===== Cards ===== -->
    <style name="Widget.Rasmal.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="strokeColor">@color/border_subtle</item>
        <item name="strokeWidth">@dimen/border_width</item>
    </style>

    <style name="Widget.Rasmal.Card.SoftGreen">
        <item name="cardBackgroundColor">@color/soft_green</item>
        <item name="strokeColor">@color/primary</item>
        <item name="strokeWidth">@dimen/border_width</item>
    </style>

    <!-- ===== Buttons ===== -->
    <style name="Widget.Rasmal.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="backgroundTint">@color/primary_strong</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:textAllCaps">false</item>
        <item name="rippleColor">@color/on_primary</item>
    </style>

    <style name="Widget.Rasmal.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="backgroundTint">@color/surface_2</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="strokeColor">@color/border_strong</item>
        <item name="strokeWidth">@dimen/border_width</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- ===== Text appearances ===== -->
    <style name="Text.Rasmal.Heading" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Rasmal.Subtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Text.Rasmal.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- ===== Dialogs ===== -->
    <!-- MaterialAlertDialogBuilder doesn't pick up the app's dark colorSurface
         override on its own, so dialogs render with the library's light default
         background unless given this overlay explicitly. -->
    <style name="ThemeOverlay.Rasmal.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorPrimary">@color/primary_strong</item>
        <item name="colorOutline">@color/border_subtle</item>
    </style>

    <!-- ===== Inputs ===== -->
    <style name="Widget.Rasmal.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxStrokeColor">@color/primary_strong</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
    </style>
</resources>
