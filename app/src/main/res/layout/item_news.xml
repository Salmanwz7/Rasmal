<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_12"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="@dimen/radius_md"
    app:cardElevation="@dimen/card_elevation"
    app:strokeColor="@color/border_subtle"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/news_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="@dimen/space_8"
                android:paddingVertical="3dp"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText"
                tools:text="ELM" />

            <TextView
                android:id="@+id/news_sentiment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText"
                tools:text="Positive" />
        </LinearLayout>

        <TextView
            android:id="@+id/news_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText"
            tools:text="Elm reports 14% YoY net profit growth in latest quarter" />

        <TextView
            android:id="@+id/news_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp"
            tools:ignore="HardcodedText"
            tools:text="Argaam · Aug 5, 2026" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
