<?xml version="1.0" encoding="utf-8"?>
<!-- Soft-green gradient hero background with a green border. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="#14432A"
        android:endColor="@color/soft_green"
        android:angle="270" />
    <corners android:radius="@dimen/radius_lg" />
    <stroke
        android:width="@dimen/border_width"
        android:color="@color/primary" />
</shape>
